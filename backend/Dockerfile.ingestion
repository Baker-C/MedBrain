# Heavy ingestion container: Unstructured hi_res system deps; runs the batch job and exits
# (Build-Spec §9). Python-side extraction deps (unstructured et al.) arrive with the
# ingestion implementation.
FROM python:3.12-slim

# hi_res needs a PDF renderer (poppler), OCR (tesseract), and OpenCV runtime libraries.
RUN apt-get update && apt-get install -y --no-install-recommends \
        poppler-utils \
        tesseract-ocr \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/
WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

COPY . .

# Starts, runs the (stub) ingestion job, and exits — no port, nothing served.
CMD ["uv", "run", "--no-sync", "python", "-m", "ingestion"]
